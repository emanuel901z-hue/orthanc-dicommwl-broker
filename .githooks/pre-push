#!/usr/bin/env bash
# Pre-push gate — CI laeuft nur bei PRs, direkte Pushes auf main sind
# ungetestet. Dieser Hook fuehrt die schnellen Stages lokal aus.
# Aktivieren: git config core.hooksPath .githooks
#
# Umgehung im Notfall: git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: running quick CI stages (pytest, tsc, lint, vitest)…"
./ci-local.sh --quick
