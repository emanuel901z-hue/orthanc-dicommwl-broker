# ── Test-stack environment ──────────────────────────────────────────────────
# Used by test-stack.sh for the ephemeral e2e stack. Own project name + own
# port range (19xxx/14xxx) so it can run IN PARALLEL to the regular stack on
# this shared host. All volumes are project-scoped and wiped by `down -v`.

COMPOSE_PROJECT_NAME=mwl-test

POSTGRES_USER=dev
POSTGRES_PASSWORD=dev

ORTHANC_NAME=MWL Test Orthanc
ORTHANC_AET=ORTHANC
ORTHANC_DICOM_PORT=14252
ORTHANC_HTTP_BIND=127.0.0.1
ORTHANC_HTTP_PORT=19042

BROKER_AET=MWLBROKER
BROKER_DICOM_PORT=11123
BROKER_API_BIND=127.0.0.1
BROKER_API_PORT=19081
BROKER_ECHO_INTERVAL_S=15
BROKER_UPSTREAM_TIMEOUT_S=10
BROKER_ALLOWED_CALLING_AETS=
BROKER_STRICT_STORE_STATUS=true
BROKER_SEEN_ITEM_TTL_DAYS=30
# Seed includes a routing rule ris-a → pacs-peer so the stack test can
# verify rule-based routing (not just the default target).
BROKER_SEED_CONFIG_JSON=[{"kind":"source","name":"ris-a","aet":"RIS_A","host":"mock-ris-a","port":11114,"calling_aet":"MWLBROKER","charset":"ISO_IR 100","priority":10},{"kind":"source","name":"ris-b","aet":"RIS_B","host":"mock-ris-b","port":11115,"calling_aet":"MWLBROKER","charset":"ISO_IR 100","priority":20},{"kind":"target","name":"orthanc","aet":"ORTHANC","host":"orthanc","port":4242,"is_default":true},{"kind":"target","name":"pacs-peer","aet":"PEER","host":"dicom-peer","port":4242,"is_default":false},{"kind":"rule","source":"ris-a","target":"pacs-peer","priority":10}]

OE3_PORT=19082

MOCK_RIS_A_PORT=19114
MOCK_RIS_B_PORT=19115
PEER_HTTP_PORT=19043
PEER_DICOM_PORT=14253

# ── OHIF viewer (docker compose --profile viewer) ────────────────────────────
OHIF_PORT=18083
OHIF_BIND=127.0.0.1
