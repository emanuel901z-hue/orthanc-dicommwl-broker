## MPPS: N-CREATE (IN PROGRESS) + N-SET (COMPLETED) mit einer *gültigen* UID.
## DVTks Beispiel nutzt den Platzhalter "MppsUID"; sein eigener Validator
## beanstandet das ("value should start with digit(s)") — deshalb hier eine
## echte UID.
SEND ASSOCIATE-RQ (
PRESENTATION-CONTEXT-ITEMS
("Modality Performed Procedure Step SOP Class", "Implicit VR Little Endian")
)
RECEIVE ASSOCIATE-AC (
PRESENTATION-CONTEXT-ITEMS
("Modality Performed Procedure Step SOP Class", 0, "Implicit VR Little Endian")
)
SEND N-CREATE-RQ "Modality Performed Procedure Step SOP Class"(
(0x00000003, "Modality Performed Procedure Step SOP Class")
(0x00001000, UI, "1.2.826.0.1.3680043.8.498.9001")
(0x00080050, SH, "ACC-DVTK-1")
(0x00080060, CS, "CT")
(0x00100010, PN, "Dvtk^Modality")
(0x00100020, LO, "DVTK-PAT-1")
(0x0020000D, UI, "1.2.826.0.1.3680043.8.498.9002")
(0x00400244, DA, "20260923")
(0x00400245, TM, "100000")
(0x00400251, IS, "1")
(0x00400252, CS, "IN PROGRESS")
(0x00400253, SH, "PPS-DVTK-1")
(0x00400254, LO, "Interop-Test")
)
RECEIVE N-CREATE-RSP(
(0x00000002, "Modality Performed Procedure Step SOP Class")
(0x00000900, 0x0000)
)
SEND N-SET-RQ "Modality Performed Procedure Step SOP Class"(
(0x00000003, "Modality Performed Procedure Step SOP Class")
(0x00001001, UI, "1.2.826.0.1.3680043.8.498.9001")
(0x00400246, DA, "20260923")
(0x00400247, TM, "101500")
(0x00400252, CS, "COMPLETED")
)
RECEIVE N-SET-RSP(
(0x00000002, "Modality Performed Procedure Step SOP Class")
(0x00000900, 0x0000)
)
SEND RELEASE-RQ
RECEIVE RELEASE-RP
