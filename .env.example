# ── mwl-broker stack configuration ──────────────────────────────────────────
# Copy to .env (bootstrap.sh does this automatically) and adjust for the host.
# All host-facing ports are configurable — this host runs other docker
# projects, so check for collisions before `docker compose up`
# (bootstrap.sh warns about occupied ports).
#
# Default ports below are deliberately NON-standard (18xxx/14xxx) because the
# common DICOM/Orthanc ports (4242, 8042, 5432, ...) are already in use on the
# reference host.

COMPOSE_PROJECT_NAME=mwl-broker
COMPOSE_FILE=docker-compose.yml

# ── Postgres (internal only — NOT exposed to the host) ──────────────────────
# Dev defaults; change for production.
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
# Database pool (raise for busy sites with many concurrent modalities)
BROKER_DB_POOL_SIZE=10
BROKER_DB_MAX_OVERFLOW=20
BROKER_DB_POOL_TIMEOUT=15

# ── Orthanc ────────────────────────────────────────────────────────────────
ORTHANC_NAME=MWL Broker Orthanc
ORTHANC_AET=ORTHANC
# DICOM port must be reachable by modalities that store directly to Orthanc
ORTHANC_DICOM_PORT=14242
# HTTP REST — bound to localhost by default (UI reaches it internally via the
# oe3 nginx proxy). Set ORTHANC_HTTP_BIND=0.0.0.0 to expose it to the LAN.
ORTHANC_HTTP_BIND=127.0.0.1
ORTHANC_HTTP_PORT=18042

# ── MWL broker ──────────────────────────────────────────────────────────────
BROKER_AET=MWLBROKER
# DICOM port — this is THE port modalities should be configured to use
# (MWL C-FIND + C-STORE)
BROKER_DICOM_PORT=11113
# REST API + metrics — localhost-only by default (proxied by oe3 nginx)
BROKER_API_BIND=127.0.0.1
BROKER_API_PORT=18081
BROKER_ECHO_INTERVAL_S=30
BROKER_UPSTREAM_TIMEOUT_S=10
# Comma-separated calling AETs allowed to query/store; empty = allow all
BROKER_ALLOWED_CALLING_AETS=
# Report DIMSE failure to the modality when forwarding fails (recommended)
BROKER_STRICT_STORE_STATUS=true
# How many days seen_items entries are kept for store routing
BROKER_SEEN_ITEM_TTL_DAYS=30

# ── C-STORE-Spool (Store and Forward) ──────────────────────────────────────
# Nicht zustellbare Instanzen werden auf Platte gepuffert und wiederholt.
# Der Ordner muss beschreibbar sein (Compose mountet dort ein Volume).
BROKER_SPOOL_DIR=/var/lib/mwl-broker/spool
# Kapazität: danach werden neue Instanzen abgewiesen (kein stiller Verlust)
BROKER_SPOOL_MAX_ITEMS=20000
BROKER_SPOOL_MAX_BYTES=10737418240
# Nach so vielen Fehlversuchen wird der Eintrag zum Dead Letter
BROKER_SPOOL_MAX_ATTEMPTS=10
# Basis für den exponentiellen Backoff (Sekunden)
BROKER_SPOOL_BACKOFF_S=60
# Wie lange ein zugestellter Eintrag als Duplikatsschutz bleibt (Sekunden)
BROKER_SPOOL_RETENTION_S=86400
# Intervall des Retry-Workers (Sekunden)
BROKER_SPOOL_POLL_S=10
# HA: wie lange eine Instanz einen Spool-Eintrag halten darf, bevor eine andere
# ihn übernehmen darf. Muss über dem Store-Timeout der Ziele liegen.
BROKER_SPOOL_LEASE_S=300
# Worklist-Cache: maximales Alter für Stale-Antworten (0 = nie)
BROKER_CACHE_STALE_MAX_S=120
# Bootstrap seed: upserted on every broker start. Default target = orthanc.
# Add real RIS/KIS sources + PACS targets here or via the UI/API.
BROKER_SEED_CONFIG_JSON=[{"kind":"target","name":"orthanc","aet":"ORTHANC","host":"orthanc","port":4242,"is_default":true}]

# ── OE3 UI ──────────────────────────────────────────────────────────────────
OE3_PORT=18082

# ── Demo profile (docker compose -f docker-compose.yml -f docker-compose.demo.yml) ──
# Two mock RIS worklist sources + a second PACS for routing tests.
MOCK_RIS_A_PORT=18114
MOCK_RIS_B_PORT=18115
PEER_HTTP_PORT=18043
PEER_DICOM_PORT=14243

# ── OHIF viewer (docker compose --profile viewer) ────────────────────────────
OHIF_PORT=18083
OHIF_BIND=127.0.0.1

# ── Zweite Instanz (Profil "ha") ────────────────────────────────────────────
# Nur nötig, wenn zwei Broker-Instanzen dieselbe Datenbank und dasselbe
# Spool-Volume teilen (Hochverfügbarkeit, siehe docs/ha.md):
#   docker compose --profile ha up -d
# Beide Instanzen erben dieselbe Umgebung; unterschiedlich sind nur der
# Instanzname und die Host-Ports.
BROKER_INSTANCE_ID=broker-a
BROKER_B_INSTANCE_ID=broker-b
BROKER_B_API_BIND=127.0.0.1
BROKER_B_API_PORT=18091
BROKER_B_DICOM_PORT=11123
BROKER_B_TLS_PORT=2763

# Herzschlag der Instanzen (Sekunden) und ab wann eine Instanz als "weg" gilt
BROKER_HA_HEARTBEAT_S=10
BROKER_HA_INSTANCE_TIMEOUT_S=60
